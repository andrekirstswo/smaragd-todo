@page "/boards/{Id}"

@using Notifications
@using Core.Models

<MudAlert Severity="Severity.Error" Variant="Variant.Outlined">Work in progress</MudAlert>

<BoardName></BoardName>

<SectionsView />

@code {
    [Parameter]
    public string Id { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        var result = await CryptoClient.GetBoard.ExecuteAsync(Id);

        ArgumentNullException.ThrowIfNull(result.Data?.Board);

        var data = result.Data.Board;

        var board = new GetBoardByIdDto
        {
            Name = data.Name,
            Accesses = data.Accesses.Select(a => new BoardUserAccess(a.UserId, a.Role)),
            BoardId = data.BoardId,
            Sections = data.Sections.Select(s => new BoardSection
            {
                Name = s.Name,
                Order = s.Order,
                BoardSectionId = s.BoardSectionId
            })
        };

        await NotificationBus.Publish(new BoardReceivedNotification(board));
    }
}

